NODE_ENV=development
PORT=4000

# postgresql://<user>:<password>@<host>:<port>/<db>
DATABASE_URL=postgresql://mavix:mavix_password@localhost:5432/mavix_estate?schema=public

# Generate strong random secrets in production, e.g.: openssl rand -base64 48
JWT_ACCESS_SECRET=change_me_dev_access_secret_min_16_chars
JWT_REFRESH_SECRET=change_me_dev_refresh_secret_min_16_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:8080

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

LOG_LEVEL=info

# Optional: secret header value required to hit /api/tenants platform-admin endpoints
PLATFORM_ADMIN_KEY=

# Optional: error tracking. Sign up at sentry.io, create a Node.js project,
# paste its DSN here. Leave blank to disable — the app works fine without it.
SENTRY_DSN=
